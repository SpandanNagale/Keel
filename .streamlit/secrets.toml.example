# Copy to .streamlit/secrets.toml (which is gitignored) and fill in.
# On Streamlit Community Cloud, paste these into the app's Secrets settings instead.
#
# Configure ONE key. When several are present, Keel picks the first it finds,
# in this order:
#   1. GROQ_API_KEY        Groq Cloud            (https://console.groq.com)
#   2. OLLAMA_API_KEY      Ollama Cloud          (https://ollama.com)
#   3. ANTHROPIC_API_KEY   Anthropic

GROQ_API_KEY = "gsk_..."
# OLLAMA_API_KEY = "..."
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: reference intake. Lets Keel scrape a URL or resolve a product name
# into candidate slot values. Every reference mode is skippable and degrades with
# a clear message when this is absent.
# FIRECRAWL_API_KEY = "fc-..."

# Optional: image reference intake needs a multimodal model. Set ANTHROPIC_API_KEY
# (Claude Haiku is multimodal), or KEEL_VISION_MODEL to a vision model on your Groq
# key, or run a local Ollama vision model with KEEL_PROVIDER=ollama.
# KEEL_VISION_MODEL = "meta-llama/llama-4-scout-17b-16e-instruct"

# Optional: override the model for whichever provider is active.
# Defaults: groq -> openai/gpt-oss-120b, ollama-cloud -> gpt-oss:120b,
#           anthropic -> claude-haiku-4-5-20251001
# KEEL_MODEL = "openai/gpt-oss-120b"

# NOTE: KEEL_PROVIDER and KEEL_OLLAMA_MODEL are environment variables, not
# secrets — set them in the shell for local dev:
#   KEEL_PROVIDER=ollama KEEL_OLLAMA_MODEL=llama3.2 streamlit run app.py
# Never set KEEL_PROVIDER=ollama on a deployed app.
